{
  "realm": "pic-torres",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "member",
        "description": "Family member: may use the gallery"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pic-torres-web",
      "name": "pic-torres web app (DEV ONLY)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-secret-never-use-in-production",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.org",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Torres",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["member"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.org",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Torres",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["member"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.org",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Guest",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "realmRoles": []
    }
  ]
}
